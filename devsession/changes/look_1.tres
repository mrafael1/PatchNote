[gd_resource type="Resource" script_class="Change" load_steps=12 format=3]

[ext_resource type="Script" path="res://devsession/change.gd" id="1"]
[ext_resource type="Script" path="res://devsession/mockup_take.gd" id="2"]
[ext_resource type="Resource" path="res://systems/looks/look_1_punchy.tres" id="3"]
[ext_resource type="Resource" path="res://systems/looks/look_1_clean.tres" id="4"]
[ext_resource type="Resource" path="res://systems/looks/look_1_arcade.tres" id="5"]
[ext_resource type="Texture2D" path="res://devsession/stills/look_1_punchy.png" id="6"]
[ext_resource type="Texture2D" path="res://devsession/stills/look_1_clean.png" id="7"]
[ext_resource type="Texture2D" path="res://devsession/stills/look_1_arcade.png" id="8"]

[sub_resource type="Resource" id="take_punchy"]
script = ExtResource("2")
id = &"punchy"
title = "Punchy"
line = "Heavy hits: screen shake, a muzzle flash on every shot, a white flash on explosions, and time stops for a frame on every hit."
image = ExtResource("6")
preset = ExtResource("3")

[sub_resource type="Resource" id="take_clean"]
script = ExtResource("2")
id = &"clean"
title = "Clean"
line = "A light touch: thin tracers, few particles, barely any shake, a very short hit stop."
image = ExtResource("7")
preset = ExtResource("4")

[sub_resource type="Resource" id="take_arcade"]
script = ExtResource("2")
id = &"arcade"
title = "Arcade"
line = "Everything louder: long tracers, huge kill pops, twice the particles, flashes, more shake and the longest hit stop."
image = ExtResource("8")
preset = ExtResource("5")

[resource]
script = ExtResource("1")
id = &"look_1"
title = "Look v1: juice"
pitch = "It plays. Now it should feel like it plays. I made three takes of the same build. Pick the one we ship."
kind = &"look"
bump = &"minor"
tags = Array[StringName]([&"look"])
due_after_run = 1
takes = Array[ExtResource("2")]([SubResource("take_punchy"), SubResource("take_clean"), SubResource("take_arcade")])
