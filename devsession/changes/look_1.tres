[gd_resource type="Resource" script_class="Change" load_steps=15 format=3]

[ext_resource type="Script" path="res://devsession/change.gd" id="1"]
[ext_resource type="Script" path="res://devsession/mockup_take.gd" id="2"]
[ext_resource type="Resource" path="res://systems/looks/look_1_punchy.tres" id="3"]
[ext_resource type="Resource" path="res://systems/looks/look_1_clean.tres" id="4"]
[ext_resource type="Resource" path="res://systems/looks/look_1_arcade.tres" id="5"]

[sub_resource type="Gradient" id="grad_punchy"]
colors = PackedColorArray(0.08, 0.09, 0.12, 1, 0.95, 0.3, 0.3, 1)

[sub_resource type="GradientTexture2D" id="still_punchy"]
gradient = SubResource("grad_punchy")
width = 480
height = 270
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 1)

[sub_resource type="Gradient" id="grad_clean"]
colors = PackedColorArray(0.08, 0.09, 0.12, 1, 0.4, 0.85, 1, 1)

[sub_resource type="GradientTexture2D" id="still_clean"]
gradient = SubResource("grad_clean")
width = 480
height = 270
fill_from = Vector2(0, 1)
fill_to = Vector2(1, 0)

[sub_resource type="Gradient" id="grad_arcade"]
colors = PackedColorArray(0.08, 0.09, 0.12, 1, 1, 0.95, 0.5, 1)

[sub_resource type="GradientTexture2D" id="still_arcade"]
gradient = SubResource("grad_arcade")
width = 480
height = 270
fill = 2
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(0.5, 0)

[sub_resource type="Resource" id="take_punchy"]
script = ExtResource("2")
id = &"punchy"
title = "Punchy"
line = "Heavy hits: full screen shake, and time stops for a frame on every hit."
image = SubResource("still_punchy")
preset = ExtResource("3")

[sub_resource type="Resource" id="take_clean"]
script = ExtResource("2")
id = &"clean"
title = "Clean"
line = "A light touch: little shake, fewer particles, a very short hit stop."
image = SubResource("still_clean")
preset = ExtResource("4")

[sub_resource type="Resource" id="take_arcade"]
script = ExtResource("2")
id = &"arcade"
title = "Arcade"
line = "Everything louder: big kill pops, lots of particles, more shake, a longer hit stop."
image = SubResource("still_arcade")
preset = ExtResource("5")

[resource]
script = ExtResource("1")
id = &"look_1"
title = "Look v1: juice"
pitch = "It plays. Now it should feel like it plays. I made three takes of the same build. Pick the one we ship."
kind = &"look"
bump = &"minor"
tags = Array[StringName]([&"look"])
due_after_run = 1
takes = Array[ExtResource("2")]([SubResource("take_punchy"), SubResource("take_clean"), SubResource("take_arcade")])
