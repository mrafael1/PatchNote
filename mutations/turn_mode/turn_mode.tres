script = ExtResource("1")
id = &"turn_mode"
title = "Turn-based"
description = "The world waits for you, and enemies move on the grid too. One turn is one action: a step, a shot, a dash, or E to wait."
line_proposal = "Real time is a performance problem. I am moving the whole game to turns."
