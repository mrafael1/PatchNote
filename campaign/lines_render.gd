extends RefCounted
## The Stage 2 lines file's text (PLAN v9 0.4, M47), from the data: tools/lines_file.gd
## writes it to campaign/lines_stage2.md and GUT's test_lines_file_is_up_to_date compares.
## (Not in the SceneTree tool itself: a -s script compiles before the autoloads exist.)

static func _line(l: Line) -> String:
	var head := ("%s " % l.when) if l.when != &"" else ""
	return "%s(%s) %s" % [head, l.expression, l.text]


static func render() -> String:
	var out: Array[String] = ["# Stage 2: every line (generated)", "",
			"Generated by `godot --headless --path . -s tools/lines_file.gd` from the data. Edit the",
			"data (campaign/sessions/*.tres, devsession/, paths/), then regenerate.", ""]
	out.append("## The stage card")
	out.append("- %s" % StageCard.LINE)
	for s: SessionDef in CampaignDB.campaign.sessions:
		if s == null or s.stage != 2:
			continue
		out.append("")
		out.append("## %s: %s" % [s.id, s.title])
		if not s.cook_beat.is_empty():
			out.append("### Cook beat (on the stage card)")
			for k in s.cook_beat:
				out.append("- %s" % k)
		out.append("### Intro")
		for l in s.intro_lines():
			out.append("- %s" % _line(l))
		out.append("### Cues")
		for c in s.cue_list():
			if c.line == null:
				continue
			var cond := ("%s " % c.cond) if c.cond != "" else ""
			var when := "%s %s" % [c.when, (str(int(c.value)) if c.value == floorf(c.value) else str(c.value))] if c.when != &"" else ""
			var what := "path %s warning: " % c.target if c.action == &"path" else ""
			out.append("- %s%s: %s%s" % [cond, when.strip_edges(), what, _line(c.line)])
		if not s.reveal_lines.is_empty():
			# M48b: said in order, one per new enemy drawn in after `skin enemies`.
			out.append("### Reveal lines (one per new enemy drawn in, in order)")
			for l in s.reveal_line_list():
				out.append("- %s" % _line(l))
		out.append("### Debrief")
		for l in s.debrief_lines():
			out.append("- %s" % _line(l))
		if not s.after_pick.is_empty():
			out.append("### After the pick")
			for l in s.after_pick_lines():
				out.append("- %s" % _line(l))
	var fork := ChangeDB.get_fork(&"fork_path")
	if fork != null:
		out.append("")
		out.append("## fork_path")
		out.append("- Question: %s" % fork.question)
		for c: Change in fork.changes():
			out.append("- %s · %s · %s" % [c.title, c.pitch, c.take.line if c.take != null else ""])
	out.append("")
	out.append("## The paths")
	for id: StringName in PathDB.ids():
		var d := PathDB.get_def(id)
		out.append("- %s: warn \"%s\" · full \"%s\" · pick \"%s\"" % [id, d.warn_line, d.full_line, d.pick_line])
	out.append("- Pick lines: %s" % " · ".join(PathRunner.PICK_LINES))
	return "\n".join(out) + "\n"
