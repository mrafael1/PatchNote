[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s2_02_day_one"
stage = 2
title = "Day one"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"level", &"health", &"hits", &"version"])
enemies = Array[StringName]([&"chaser", &"shooter", &"fork:fork_enemy"])
spawn_rate = 1.3
spawn_cap = 1.3
path = &"fork:fork_path"
weapons = Array[StringName]([&"pistol", &"shotgun"])
hp_floor = 0
goal = &"survive"
goal_value = 120.0
face = true
intro = PackedStringArray("answer:path_arsenal happy: Cards. Today it's you and one card: the pistol.", "answer:path_auto happy: Auto. Don't touch the trigger. I mean it.", "answer:path_survival happy: Scavenger. You get a pistol. The rest is out there.", "thinking: Two minutes. I'll build it properly this time.")
cues = PackedStringArray("answer:path_arsenal at 10: add cards", "answer:path_arsenal at 10: say happy: Remember the cards? Now they're real. Rank pips, a meter. Twenty-five kills, a new card.", "answer:path_arsenal at 20: add quick_draw", "answer:path_arsenal at 20: say thinking: Secret: the first shot after a switch hits twice as hard. Switch a lot.", "answer:path_auto at 10: add levelups", "answer:path_auto at 10: say happy: Remember the gems? Now they count. Real levels, a real bar.", "answer:path_auto at 14: add crowd", "answer:path_auto at 14: say worried: And I made the crowd bigger again. Sorry. You need it.", "answer:path_survival at 10: add pickups", "answer:path_survival at 10: say happy: Remember the guns on the floor? Now they come in crates. Two now, one every twenty seconds.", "answer:path_survival at 22: say thinking: Walk over another gun to swap. Yours drops at your feet.", "answer:path_survival at 36: say happy: Run dry and you get the pistol back. It never runs out.", "answer:path_survival kills 5: add kill_heal", "answer:path_survival kills 5: say proud: And kills heal you. Like I promised.", "at 30: give shotgun", "at 30: say happy: The shotgun's in. Close range, big mess.", "at 50: spawn splitter 2", "at 50: say surprised: New enemy. It's two enemies. Sort of.")
debrief = PackedStringArray("won happy: Day one. It works!", "died guilty: Day one bugs. Want another go, or should I just patch it?", "answer:path_auto&hit_none surprised: You didn't touch the trigger and didn't get touched. Fair.", "answer:path_arsenal thinking: Cards feel good. I want more of them.", "answer:path_survival thinking: You're a good scavenger. Suspiciously good.")
bump = &"patch"
notes = PackedStringArray("Day one", "The shotgun", "New enemy: the splitter")
