[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s2_01_tryout"
stage = 2
title = "Three games"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"level", &"health", &"hits", &"version"])
enemies = Array[StringName]([&"chaser", &"shooter", &"fork:fork_enemy"])
spawn_rate = 1.3
spawn_cap = 1.3
weapons = Array[StringName]([&"pistol", &"shotgun"])
tryout = true
hp_floor = 1
goal = &"script"
goal_value = 5.0
end_after = 5.0
face = true
cues = PackedStringArray("at 4: path arsenal happy: Version one. Your guns are cards.", "at 6: add cards", "at 6: give shotgun", "at 8: say happy: {key:weapon_prev} and {key:weapon_next} to switch cards. Six kills, I'll deal you a pack.", "picked 1: say proud: See? Same card, stronger gun.", "at 36: say proud: Okay. Saving that one.", "at 40: path survival happy: Version two. Guns lying around.", "at 42: add pickups", "at 42: say happy: And a revolver. Six shots, then it reloads.", "at 45: drop shotgun", "at 45: say happy: Walk over a gun to take it. Ammo runs out, so keep looking.", "at 58: add kill_heal", "at 58: say thinking: And every few kills patch you up. Kills are food.", "at 73: say proud: Saving that too.", "at 76: path auto worried: Version three. Hands off the trigger.", "at 80: say surprised: It shoots for you. You just move.", "at 84: add crowd", "at 84: say happy: And more enemies. Lots more. You'll need them.", "at 89: add levelups", "at 89: say happy: Grab the gems. You'll level up.", "at 105: say panic: That's a lot of them. That's the point!", "at 110: path off", "at 112: say thinking: Okay. Three games. I can only build one.")
debrief = PackedStringArray("thinking: So. Three versions of the same game.", "hit_lots worried: You took a beating in there. Prototypes, sorry.", "thinking: I can only build one of them properly.")
before_play = PackedStringArray("happy: Stage two. I want to make a real shooter.", "thinking: But which kind? Let's try three. Quick ones.", "worried: Can't lose today. It's a tryout.", "proud: Three games. You try each one. Type play.")
fork = &"fork_path"
bump = &"minor"
notes = PackedStringArray("The shooter, three ways", "Added a title screen.", "Added options (audio, video, controls, accessibility).", "Added a pause menu.")
after_pick = PackedStringArray("happy: The other two go in a drawer. I never throw anything away.")
cook_beat = PackedStringArray("Trying three kinds of shooter...", "Compiling... mostly.", "One of them is on fire.", "Done. Mostly.")
door_beat = PackedStringArray("thinking: Before I build three shooters, this game needs a front door.", "proud: Options. Real ones. They even save.", "happy: And {key:pause} finally does something.")
