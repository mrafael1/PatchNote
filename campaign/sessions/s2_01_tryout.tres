[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s2_01_tryout"
stage = 2
title = "Three games"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"level", &"health", &"hits", &"version"])
enemies = Array[StringName]([&"chaser", &"shooter", &"fork:fork_enemy"])
spawn_rate = 1.3
spawn_cap = 1.3
weapons = Array[StringName]([&"pistol", &"shotgun"])
tryout = true
hp_floor = 1
goal = &"stop"
goal_value = 150.0
face = true
intro = PackedStringArray("happy: Stage two. I want to make a real shooter.", "thinking: But which kind? Let's try three. Quick ones.", "worried: Can't lose today. It's a tryout.")
cues = PackedStringArray("at 13: path arsenal happy: Version one. Your guns are cards.", "at 15: add cards", "at 15: give shotgun", "at 17: say happy: {key:weapon_prev} and {key:weapon_next} to switch cards. Kill some, I'll deal you a new one.", "picked 1: say proud: See? Better gun, same card.", "at 52: say proud: Okay. Saving that one.", "at 56: path survival happy: Version two. No cards. Guns are lying around.", "at 58: add pickups", "at 61: drop shotgun", "at 61: say happy: Walk over a gun to take it. Ammo runs out, so keep looking.", "at 74: add kill_heal", "at 74: say thinking: And every few kills patch you up. Kills are food.", "at 95: say proud: Saving that too.", "at 99: path auto worried: Version three. Hands off the trigger.", "at 103: say surprised: It shoots for you. You just move.", "at 107: add crowd", "at 107: say happy: And more enemies. Lots more. You'll need them.", "at 112: add levelups", "at 112: say happy: Grab the gems. You'll level up.", "at 128: say panic: That's a lot of them. That's the point!", "at 143: path off", "at 145: say thinking: Okay. Three games. I can only build one.")
debrief = PackedStringArray("happy: Like the new chat? I redecorated.", "thinking: So. Three versions of the same game.", "hit_lots worried: You took a beating in there. Prototypes, sorry.", "thinking: I can only build one of them properly.")
fork = &"fork_path"
bump = &"minor"
notes = PackedStringArray("The shooter, three ways", "Added a title screen.", "Added options (audio, video, controls, accessibility).", "Added a pause menu.")
after_pick = PackedStringArray("happy: The other two go in a drawer. I never throw anything away.")
cook_beat = PackedStringArray("Trying three kinds of shooter...", "Compiling... mostly.", "One of them is on fire.", "Done. Mostly.")
door_beat = PackedStringArray("thinking: Before I build three shooters, the front door needs work.", "proud: Options. Real ones. They even save.", "happy: And {key:pause} finally does something.")
