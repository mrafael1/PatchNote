[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s1_04_level"
stage = 1
title = "A level"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"health", &"hits"])
enemies = Array[StringName]([&"chaser", &"shooter"])
spawn_after = 3.5
goal = &"clear"
goal_value = 14.0
time_limit = 90.0
enemy_total = 14
face = true
cues = PackedStringArray("at 0.3: say proud: Walls. Watch this.", "at 0.8: add level", "dash:classic&dash_aim:aim at 5: say happy: And a dash. Shift or right click, where you aim.", "dash:classic&dash_aim:move at 5: say happy: And a dash. Shift or right click, where you move.", "dash:grapple&dash_aim:aim at 5: say happy: A wall hook. Shift or right click, where you aim.", "dash:grapple&dash_aim:move at 5: say happy: A wall hook. Shift or right click, where you move.", "dash:teleport&dash_aim:aim at 5: say happy: A teleport. Shift or right click, where you aim.", "dash:teleport&dash_aim:move at 5: say happy: A teleport. Shift or right click, where you move.", "at 12: edit edit_bouncy_walls 10")
debrief = PackedStringArray("won happy: Good run.", "died guilty: Too many at once. My bad.", "hit_none proud: Not a scratch. The walls helped, right?", "thinking: I want a new enemy.")
before_play = PackedStringArray("mascot:cursor happy: Look, I can point now.", "mascot:window happy: Finally, a window of my own.", "mascot:blob happy: I'm... squishy? I'm squishy.", "proud: I made you a level. Type play.")
fork = &"fork_enemy"
bump = &"minor"
