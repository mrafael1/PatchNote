[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s1_04_level"
stage = 1
title = "A level"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"level"])
enemies = Array[StringName]([&"chaser", &"shooter"])
goal = &"survive"
goal_value = 30.0
face = true
intro = PackedStringArray("mascot:cursor happy: Look, I can point now.", "mascot:window happy: Finally, a window of my own.", "mascot:blob happy: I'm... squishy? I'm squishy.", "proud: Better. Right? I made walls too.", "happy: And you can dash now. Shift or right click.")
debrief = PackedStringArray("won happy: Good run.", "died guilty: Too many at once. My bad.", "hit_none proud: You didn't even get hit. Show-off.", "thinking: I want a new enemy.")
fork = &"fork_enemy"
bump = &"minor"
