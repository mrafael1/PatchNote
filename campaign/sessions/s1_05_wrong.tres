[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s1_05_wrong"
stage = 1
title = "The wrong slider"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"level", &"health", &"hits"])
enemies = Array[StringName]([&"chaser", &"shooter", &"fork:fork_enemy"])
spawn_rate = 0.8
goal = &"kills"
goal_value = 20.0
time_limit = 150.0
face = true
intro = PackedStringArray("proud: New enemy's in. The one you picked.", "happy: Twenty this time. I'll keep tuning things as we go.")
cues = PackedStringArray("at 6: spawn fork:fork_enemy 1", "at 15: add version", "at 15: say proud: See the number up there? That's my version.", "at 20: event wrong_variable")
debrief = PackedStringArray("event:wrong_variable guilty: So. About the gravity thing.", "event:wrong_variable guilty: Let's never speak of it.", "died guilty: Ouch. That one's on me.", "won happy: Twenty. Made it.", "stopped thinking: Time's up. Close enough.", "hit_none proud: You didn't even get hit. Show-off.")
before_play = PackedStringArray("proud: New enemy. Lots of them. Type play.")
bump = &"minor"
notes = PackedStringArray("Gravity fixed (mostly)")
