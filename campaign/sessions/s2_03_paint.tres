[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s2_03_paint"
stage = 2
title = "Fresh paint"
basics = Array[StringName]([&"movement", &"shooting", &"dash", &"enemies", &"level", &"health", &"hits", &"version"])
enemies = Array[StringName]([&"chaser", &"shooter", &"fork:fork_enemy"])
spawn_rate = 1.3
spawn_cap = 1.3
path = &"fork:fork_path"
weapons = Array[StringName]([&"pistol", &"shotgun", &"laser"])
hp_floor = 0
skin = &"pixel"
look_reveal = &"manual"
spawn_after = 9.0
reveal_lines = PackedStringArray("happy: Another one!", "proud: Drew that one too.", "happy: Ooh. That one came out nice.", "surprised: That one has teeth now.")
goal = &"clear"
time_limit = 210.0
enemy_total = 120
enemy_total_by_path = Dictionary[StringName, int]({
&"arsenal": 120,
&"auto": 220,
&"survival": 70
})
fresh_start = true
face = true
intro = PackedStringArray("happy: I learned to draw. Watch this one.")
cues = PackedStringArray("answer:path_arsenal at 0: add cards", "answer:path_arsenal at 0: add quick_draw", "answer:path_auto at 0: add levelups", "answer:path_auto at 0: add crowd", "answer:path_survival at 0: add pickups", "answer:path_survival at 0: add kill_heal", "at 1: spawn chaser 1 specimen", "at 3: skin chaser morph", "at 6.5: say proud: My first asset! Look at it. LOOK at it.", "at 9: release", "at 9: say happy: Okay. You can shoot it now. Gently.", "at 14: skin player morph", "at 14: say thinking: Your turn. Hold still. ...Or don't. I can draw moving things now.", "at 20: skin shots", "at 20: skin enemies", "at 28: skin bug swap 3", "at 28.5: say surprised: That's you. Why are they all you? Fixing!", "at 40: skin arena morph", "at 40: say happy: Now the room.", "at 44: skin bug tiles 2.5", "at 44.5: say worried: Too much brick. One second.", "at 55: skin ui", "at 55: say proud: The screen too. Boxes with corners!", "at 62: skin bug flip 2", "at 62.5: say guilty: They're upside down. They don't mind. I do.", "at 70: skin mascot", "mascot:blob at 70: say surprised: I'm... a different colour? I like it.", "mascot:cursor at 70: say surprised: My arrow looks great.", "mascot:window at 70: say surprised: New theme. Finally.", "at 72: skin all", "at 74: say proud: There. That's us now.", "!answer:path_arsenal at 80: give laser", "!answer:path_arsenal at 80: say happy: New gun: the laser. It goes through things.", "answer:path_auto at 90 [nova]: say happy: And a nova for you. It pops around you.", "answer:path_arsenal at 11: give shotgun 3", "answer:path_arsenal at 11: say happy: Your shotgun's back. Rank three, on me.", "answer:path_arsenal at 78: say happy: New trick. I can glue two cards into one.", "answer:path_arsenal at 79: fuse fail", "answer:path_arsenal at 82: say misfused surprised: It's a pistol. That shoots pistols. Sideways.", "answer:path_arsenal at 86: say misfused guilty: Undoing. Not every pair goes together.", "answer:path_arsenal at 86: give laser 3", "answer:path_arsenal at 86: say happy: New gun: the laser. Gold, rank three. Take it, or keep your hand.", "answer:path_arsenal at 94: add fusion", "answer:path_arsenal at 94: say paired thinking: Real fusion now. Two cards at rank four light a link.", "answer:path_arsenal fuse_ready 1: say happy: The link's glowing. Open the next pack and fuse them.", "answer:path_arsenal fused 1: say proud: A Prism! That recipe goes in the book.", "answer:path_arsenal give_choice 1: say give_kept thinking: Keeping your hand? Fair. The laser's in the packs now.", "answer:path_arsenal give_choice 1: say give_taken&paired happy: Laser and shotgun. Those two go together.", "answer:path_arsenal give_choice 1: say give_taken&!paired thinking: Laser and pistol. No recipe for those two. Yet.", "answer:path_arsenal at 94: say !paired thinking: Real fusion now. The laser and the shotgun make something. Hold both.", "answer:path_auto at 9: give haste", "answer:path_auto holds haste: say happy: Haste came back with you. Guns fire faster.", "answer:path_auto at 94 [might]: say thinking: Might makes everything hit harder. Nova evolves with it.", "answer:path_auto at 84: add evolve", "answer:path_auto at 84: say happy: New trick. A gun at rank six plus its passive evolves.", "answer:path_auto evolve_ready 1: say happy: It's glowing. Take EVOLVE.", "answer:path_auto evolved 1: nerf 8", "answer:path_auto evolved 1: say surprised: Oh. Oh no. That came out strong.", "answer:path_auto nerfed 1: say guilty: Too strong. Patched it down live. Still good, promise.")
debrief = PackedStringArray("won proud: It looks like a game now. Almost.", "died guilty: The paint was still wet. My fault.", "happy: I'm... chunky. I love it.", "answer:path_auto thinking: The cards are still in the drawer. Just saying.", "answer:path_arsenal thinking: The gems are still in the drawer.", "answer:path_survival thinking: The cards are still in the drawer. And the gems.", "answer:path_arsenal&fused proud: You fused one. I'm keeping the recipe.", "answer:path_arsenal&!fused thinking: No fusion today. The recipe's still there.", "answer:path_auto&evolved proud: You evolved one. I only nerfed it a little.", "thinking: It's one room. Games have levels.")
fork = &"fork_layout"
before_play = PackedStringArray("happy: Day two. Type play.")
bump = &"patch"
notes = PackedStringArray("A new look: Pixel", "The laser")
