[gd_resource type="Resource" script_class="SessionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://campaign/session_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"s1_03_shooting"
stage = 1
title = "Shooting"
basics = Array[StringName]([&"movement", &"shooting", &"enemies", &"health"])
enemies = Array[StringName]([&"chaser"])
goal = &"clear"
goal_value = 3.0
time_limit = 120.0
enemy_total = 0
face = true
intro = PackedStringArray("happy: Okay. Shoot.")
cues = PackedStringArray("at 0.5: spawn chaser 2", "at 5: say surprised: ...through?", "at 7: say guilty: They don't feel it. One sec.", "at 9.5: add hits", "kills 1: say happy: Oh. That works.", "kills 2: spawn chaser 1", "kills 2: say happy: One more. For practice.")
debrief = PackedStringArray("won proud: Three for three. That's shooting.", "died guilty: Too many at once. My fault.", "stopped thinking: Close enough.")
before_play = PackedStringArray("happy: Gun's in. Go get them.")
auto_start = true
fork = &"fork_dash"
more_forks = Array[StringName]([&"fork_dash_aim"])
bump = &"minor"
notes = PackedStringArray("Bullets that hit things now", "A level", "Enemies that shoot back")
